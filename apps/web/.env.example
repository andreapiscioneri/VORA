NUXT_PUBLIC_APP_NAME=Vora
NUXT_PUBLIC_APP_URL=http://localhost:3100

# Firestore — in local dev, FIRESTORE_EMULATOR_HOST makes the app talk to
# `firebase emulators:start` and no real credentials are needed.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_PROJECT_ID=vora-dev

# Required only in production (real Firebase project, no emulator):
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Communications — without these, Email/WhatsApp use MockEmailProvider /
# MockWhatsAppProvider (server/services/email, server/services/whatsapp):
# sends are recorded locally, nothing goes out over the network.
# EMAIL_PROVIDER_API_KEY=
# WHATSAPP_API_KEY=
# WHATSAPP_WEBHOOK_SECRET=

# AI — without this, classification/task-extraction use HeuristicAIService
# (server/services/ai): rule-based keyword matching, no LLM call, no network.
# AI_API_KEY=
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-secret-in-production

# OAuth — without these, GET /api/auth/google cleanly redirects to
# /login?error=oauth_failed instead of crashing (nuxt-auth-utils detects the
# missing config). Get real values from https://console.cloud.google.com
# (APIs & Services → Credentials → OAuth client ID → Web application).
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
