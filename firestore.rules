rules_version = '2';

// All reads/writes go through the Nuxt server API using the Admin SDK,
// which bypasses these rules. This default-deny rule only protects
// against any accidental direct client-side Firestore access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
