{
  "name": "vora",
  "version": "0.1.0",
  "private": true,
  "description": "VORA — the calm AI operating system for work.",
  "type": "module",
  "imports": {
    "#internal/nuxt/paths": "./.nuxt/paths.mjs"
  },
  "scripts": {
    "dev": "nuxt dev --port 3100 --host",
    "dev:web": "nuxt dev --port 3100 --host",
    "dev:mobile": "cd mobile && npm start",
    "build": "nuxt build",
    "build:web": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "db:seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "^10.2.4",
    "@pinia/nuxt": "^0.9.0",
    "@vueuse/nuxt": "^12.3.0",
    "firebase-admin": "^14.2.0",
    "marked": "^18.0.9",
    "nuxt": "^3.21.2",
    "nuxt-auth-utils": "^0.5.30",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/tailwindcss": "^6.13.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18.17.0"
  }
}
